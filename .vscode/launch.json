{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run FastAPI Engine & Dashboard (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "🚀 Run FastAPI Engine (Port 8080 Alternative)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "📊 Run Quantitative Benchmark Runner",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/benchmark/run_benchmarks.py",
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Run Unit & Hygiene Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "console": "integratedTerminal"
    }
  ]
}
